{
  "id": "apple_support_clone",
  "name": "官网帮助中心·知识库",
  "version": "1.0.0",
  "mode": "clone",
  "framework": "laravel",
  "geoflow_contract": "site-theme-view-resolver",
  "created_at": "2026-05-30",
  "description": "中国企业官网帮助中心风格：清晰分类导航、问题导向文章与相关主题推荐，适合沉淀品牌知识库与可被 AI 检索的支持文档。保留 GEOFlow 路由与文章/分类数据契约。",
  "compatible_pages": [
    "home",
    "article",
    "category",
    "archive-index",
    "archive-month"
  ],
  "compatible_modules": [
    "layout",
    "home.hero",
    "home.featured_articles",
    "home.latest_articles",
    "category.header",
    "category.article_list",
    "article.header",
    "article.prose",
    "article.tags",
    "article.related_articles",
    "article.sticky_ad",
    "archive.overview",
    "archive.article_list"
  ],
  "preview_routes": [
    "/",
    "/category/{slug}",
    "/article/{slug}",
    "/archive"
  ],
  "requires_admin_activation": true,
  "blade_templates": [
    "layout.blade.php",
    "home.blade.php",
    "article.blade.php",
    "category.blade.php",
    "archive-index.blade.php",
    "archive-month.blade.php",
    "partials/article-card.blade.php"
  ],
  "fallback_templates": [],
  "notes": "面向中国 GEO 生态；保留 GEOFlow 前台数据契约。后台启用后即可预览。",
  "locale": "zh_CN",
  "ecosystem_focus": "china_geo",
  "ecosystem": "knowledge",
  "strategy_tags": [
    "帮助中心",
    "知识库"
  ]
}
