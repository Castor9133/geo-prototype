# ============================================
# GEOrank — 环境变量配置模板
# 复制本文件为 .env 并填入实际值
# ============================================

# ----- 基础 -----
DEBUG=true
# 生产环境必须改为 false，并使用 HTTPS PUBLIC_BASE_URL 与三组独立随机密钥。
SECRET_KEY=change-me-secret-key
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key
PUBLIC_BASE_URL=http://localhost:3009
# 本地演示：未登录也可使用诊断 / 拓词 / 问答（生产请设为 false）
GEORANK_ALLOW_ANONYMOUS_AI=true
# JSON 数组；生产环境仅保留正式域名与内部健康检查所需主机名
TRUSTED_HOSTS=["localhost","127.0.0.1","api","app.georank.com","*.georank.com"]

# ----- 内容后端模式（M1：统一 Python / F2 双轨）-----
# native-python：知识库/任务/分发走 GEORank 原生（默认演示）
# legacy-flow：Suite 仍 handoff 到 Laravel GEOFlow（对照用）
CONTENT_BACKEND_MODE=native-python

# ----- GEO Suite / GEOFlow 集成（可选 · legacy-flow）-----
# 演示默认不需要 GEOFlow。仅 F2 对照时启用。
# API 容器访问本机 GEOFlow 时用 host.docker.internal；浏览器打开用 localhost。
GEOFLOW_ENABLED=false
GEOFLOW_BASE_URL=http://host.docker.internal:18080
GEOFLOW_PUBLIC_BASE_URL=http://localhost:18080
GEOFLOW_API_TOKEN=
# GEO Suite Phase1/2：与 GEOFlow .env 保持同一密钥
GEOSUITE_SSO_SECRET=
GEOSUITE_CALLBACK_SECRET=
GEOSUITE_PUBLIC_URL=http://localhost:3009

# ----- PostgreSQL -----
# 本机裸跑（推荐）：POSTGRES_HOST=127.0.0.1
# Compose legacy：POSTGRES_HOST=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=georank
POSTGRES_USER=georank
POSTGRES_PASSWORD=change-me-postgres-password

# ----- Redis -----
# 本机裸跑（推荐）：REDIS_HOST=127.0.0.1
# Compose legacy：REDIS_HOST=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ----- Qdrant -----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=companies

# ----- Neo4j -----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# ----- MinIO -----
MINIO_ENDPOINT=minio:9000
MINIO_USER=change-me-minio-access-key
MINIO_PASSWORD=change-me-minio-secret-key

# ----- AI / LLM -----
# 默认：DeepSeek V4 Flash（OpenAI 兼容）
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
#
# 也可换成其他 OpenAI 兼容网关：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# LLM_MODEL=your-chat-model

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# Keep false for SSRF protection. Set true only for trusted self-hosted LLMs on private networks;
# this also permits HTTP endpoints, so restrict network access around the backend service.
ALLOW_PRIVATE_LLM_PROVIDER_URLS=false

# 向后兼容（未单独配 LLM 时可能回退读取）
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# ----- Embedding（需单独配置兼容 OpenAI 格式的 Embedding 服务，或留空降级同类推荐） -----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ----- JWT -----
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=1440

# ----- 种子账号（可选；留空时 seed 脚本会随机生成一次性密码并打印） -----
GEORANK_SEED_ADMIN_PASSWORD=
GEORANK_SEED_DEMO_PASSWORD=
GEORANK_SEED_TEST_PASSWORD=
